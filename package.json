{
  "name": "nurfia-clone",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2",
    "esbuild": "^0.28.1",
    "js-yaml": "^4.3.2"
  },
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:backend": "cd backend && npm run dev",
    "build": "cd frontend && npm run build",
    "seed": "cd backend && npx prisma db seed"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "prisma": "^6.19.3",
    "tsx": "^4.23.15"
  }
}
