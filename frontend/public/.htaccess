<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Use a fixed canonical host to avoid Host-header based redirects.
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://vanhoang.mauweb68.com%{REQUEST_URI} [R=301,L,NE]

  # Keep hidden deployment files out of SPA fallback; allow ACME challenges.
  RewriteRule (^|/)\.(?!well-known(?:/|$)) - [F,L]
  
  # Hỗ trợ MIME types cho các file JS/CSS trong trường hợp Host chưa cấu hình
  <IfModule mod_mime.c>
    AddType application/javascript .js
    AddType text/css .css
  </IfModule>

  # Nếu file hoặc thư mục tồn tại thì truy cập trực tiếp
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Nếu không tồn tại thì trỏ về index.html để React Router xử lý
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000" "expr=%{HTTPS} == 'on'"
  Header always set Content-Security-Policy "frame-ancestors 'self'; object-src 'none'; base-uri 'self'"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
